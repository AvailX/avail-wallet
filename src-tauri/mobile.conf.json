{
  "productName": "Avail",
  "identifier": "com.avail.wallet",
  "build": {
    "beforeDevCommand": "cd src-mobile && npm i && npm run dev",
    "beforeBuildCommand": "cd src-mobile && npm i && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "deep-link": {
    "domains": [
      {
        "host": "com.avail.wallet",
        "pathPrefix": [
          "avail://"
        ]
      }
    ]
  }
},
"app": {
  "security": {
    "csp": null
  },
  "withGlobalTauri": true,
  "windows": [
    {
      "fullscreen": false,
      "resizable": true,
      "title": "Avail",
      "width": 1125,
      "height": 800,
      "minWidth": 843.75,
      "minHeight": 600
    }
  ]
}
}